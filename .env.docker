# Docker development environment variables
# Copy to .env.docker.local and customize if needed

# Django
# SECRET_KEY="z9$g7#k2v1p8q6r4s0t!m5n3b@h^y&u*o-l=+cwf_XA7!bK2%p"
DEBUG=False
ENV_TYPE=production
ALLOWED_HOSTS=localhost,127.0.0.1,backend,api-mantracrm.mantraideas.com.np,*.mantraideas.com.np,mantracrm.mantraideas.com.np
DOMAIN_NAME=https://api-mantracrm.mantraideas.com.np/
SWAGGER_ROOT_URL=https://api-mantracrm.mantraideas.com.np/

# Database (must match docker-compose db service)
DBNAME=crm_db
DBUSER=crm_user
DBPASSWORD=crm_password
DBHOST=db
DBPORT=5432

# Postgres superuser (used by db service to create the database)
POSTGRES_DB=crm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

